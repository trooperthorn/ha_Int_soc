#!/usr/bin/with-contenv bashio
# Firewall command poller: the only part of this add-on that mutates host state. Design in docs/security.md and firewall.py.
set -uo pipefail

CHAIN="HA_SOC_RULES"
STATE_DIR="/data"
CURRENT_TEST_FILE="${STATE_DIR}/ha_soc_fw_current_test_id"
# Shared with the scanner and SNMP services via /data; see ensure_probe_secret.
SECRET_FILE="${STATE_DIR}/ha_soc_probe_secret"
POLL_URL="http://supervisor/core/api/services/ha_soc/poll_firewall_command?return_response"
INGEST_URL="http://supervisor/core/api/services/ha_soc/ingest_probe_result"
POLL_INTERVAL_SECONDS=5
PROBE_SECRET=""

# REASON_MAX_CHARS must match the integration's FIREWALL_REPORT_REASON_MAX; window and rule-count bounds mirror Core's schema.
REASON_MAX_CHARS=200
WINDOW_MIN_SECONDS=5
WINDOW_MAX_SECONDS=3600
MAX_RULES=200

# Recomputed before every apply and report, never cached.
IPV6_SUPPORTED=0

# Set by the TERM/INT trap; checked at every poll step.
STOP_REQUESTED=0

# Full-table dumps are for manual recovery only; never fed to iptables-restore.
backup_path_for() { echo "${STATE_DIR}/ha_soc_fw_backup_${1}.rules"; }
backup6_path_for() { echo "${STATE_DIR}/ha_soc_fw_backup6_${1}.rules"; }
# Chain-only snapshots, the ones a revert replays.
chain_backup_path_for() { echo "${STATE_DIR}/ha_soc_fw_chain_${1}.rules"; }
chain6_backup_path_for() { echo "${STATE_DIR}/ha_soc_fw_chain6_${1}.rules"; }
resolved_marker_for() { echo "${STATE_DIR}/ha_soc_fw_resolved_${1}"; }

# Same regex as resource_watchdog.ADDON_SLUG_PATTERN; revalidated before any Docker URL is built.
valid_slug() {
    printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,63}$'
}

# Every delivered field is revalidated here because a compromised Core is inside the threat model.

valid_action() { [ "$1" = "allow" ] || [ "$1" = "deny" ]; }
valid_proto() { [ "$1" = "tcp" ] || [ "$1" = "udp" ]; }
valid_family() { [ "$1" = "4" ] || [ "$1" = "6" ] || [ "$1" = "both" ]; }

valid_port() {
    printf '%s' "$1" | grep -Eq '^[0-9]{1,5}$' || return 1
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_window() {
    printf '%s' "$1" | grep -Eq '^[0-9]{1,5}$' || return 1
    [ "$1" -ge "${WINDOW_MIN_SECONDS}" ] && [ "$1" -le "${WINDOW_MAX_SECONDS}" ]
}

# Shape allowlist only (keeps metacharacters out); iptables is the final judge of the address.
valid_source_for_family() {
    local source="$1" family="$2"
    printf '%s' "${source}" | grep -Eq '^[0-9A-Fa-f:.]{1,49}(/[0-9]{1,3})?$' || return 1
    case "${family}" in
        4) case "${source}" in *:*) return 1 ;; esac ;;
        6) case "${source}" in *:*) : ;; *) return 1 ;; esac ;;
        *) return 1 ;;
    esac
    return 0
}

# Docker hard caps need docker_api plus Protection Mode off; re-applied every LIMIT_APPLY_EVERY cycles because Supervisor recreates containers.
DOCKER_SOCK="/var/run/docker.sock"
LIMITS_FILE="${STATE_DIR}/ha_soc_resource_limits.json"
LIMIT_APPLY_EVERY=12  # x POLL_INTERVAL_SECONDS = ~60s
# Core is treated as hostile input here because this process holds the Docker socket.
# shellcheck source=/usr/lib/ha_soc/resource_limits.sh
source /usr/lib/ha_soc/resource_limits.sh

# noclobber makes the creation race safe; Core pins the first secret presented and rejects mismatches.
ensure_probe_secret() {
    if [ ! -s "${SECRET_FILE}" ]; then
        ( set -o noclobber
          umask 077
          head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1 > "${SECRET_FILE}"
        ) 2>/dev/null || true
    fi
    # Tighten a pre-existing file too; the first live verification run
    # found it at 0644 (see the scanner service's twin comment).
    chmod 600 "${SECRET_FILE}" 2>/dev/null || true
    PROBE_SECRET="$(cat "${SECRET_FILE}" 2>/dev/null || echo "")"
}

# Family "both" never reaches this; callers expand it into one call per family.
ipt_bin_for() {
    if [ "$1" = "6" ]; then echo "ip6tables"; else echo "iptables"; fi
}

# Truth of this moment, not a cached startup answer.
probe_ipv6_supported() {
    if ip6tables -S >/dev/null 2>&1; then
        IPV6_SUPPORTED=1
    else
        IPV6_SUPPORTED=0
    fi
}

ipv6_supported_json() {
    if [ "${IPV6_SUPPORTED}" -eq 1 ]; then echo "true"; else echo "false"; fi
}

# The INPUT jump must sit at position 1: a deny below a broad accept is cosmetic. Uninstall cleanup is best-effort; see docs/operations.md.
ensure_chain() {
    iptables -N "${CHAIN}" 2>/dev/null || true
    if ! iptables -C INPUT -j "${CHAIN}" 2>/dev/null; then
        iptables -I INPUT -j "${CHAIN}"
    fi
    if [ "${IPV6_SUPPORTED}" -eq 1 ]; then
        ip6tables -N "${CHAIN}" 2>/dev/null || true
        if ! ip6tables -C INPUT -j "${CHAIN}" 2>/dev/null; then
            ip6tables -I INPUT -j "${CHAIN}"
        fi
    fi
}

flush_chain() {
    iptables -F "${CHAIN}" 2>/dev/null || true
    if [ "${IPV6_SUPPORTED}" -eq 1 ]; then
        ip6tables -F "${CHAIN}" 2>/dev/null || true
    fi
}

# Returns the iptables binary's exit status so a silently failed rule is detectable.
apply_rule() {
    local family="$1" action="$2" proto="$3" port="$4" source="$5" target="ACCEPT" bin
    bin=$(ipt_bin_for "${family}")
    [ "${action}" = "deny" ] && target="DROP"
    if [ -n "${source}" ] && [ "${source}" != "null" ]; then
        "${bin}" -A "${CHAIN}" -s "${source}" -p "${proto}" --dport "${port}" -j "${target}"
    else
        "${bin}" -A "${CHAIN}" -p "${proto}" --dport "${port}" -j "${target}"
    fi
}

# Runs before anything touches either chain; sets RULES_REJECT_REASON on failure.
RULES_REJECT_REASON=""
validate_ruleset() {
    local rules_json="$1" count i rule action proto port source family
    RULES_REJECT_REASON=""
    count=$(echo "${rules_json}" | jq 'length' 2>/dev/null || echo "-1")
    if ! printf '%s' "${count}" | grep -Eq '^[0-9]+$' || [ "${count}" -lt 1 ] || [ "${count}" -gt "${MAX_RULES}" ]; then
        RULES_REJECT_REASON="rejected by add-on: rule count out of bounds"
        return 1
    fi
    for (( i = 0; i < count; i++ )); do
        rule=$(echo "${rules_json}" | jq -c ".[${i}]")
        action=$(echo "${rule}" | jq -r '.action // ""')
        proto=$(echo "${rule}" | jq -r '.proto // ""')
        port=$(echo "${rule}" | jq -r '.port // ""')
        source=$(echo "${rule}" | jq -r '.source // "null"')
        family=$(echo "${rule}" | jq -r '.family // "both"')
        if ! valid_action "${action}" || ! valid_proto "${proto}" \
            || ! valid_port "${port}" || ! valid_family "${family}"; then
            RULES_REJECT_REASON="rejected by add-on: rule ${i} has an invalid action, proto, port, or family"
            return 1
        fi
        if [ "${source}" != "null" ] && ! valid_source_for_family "${source}" "${family}"; then
            RULES_REJECT_REASON="rejected by add-on: rule ${i} has an invalid source for family ${family}"
            return 1
        fi
    done
    return 0
}

# Flush-then-apply of the FULL desired state; any failure in either table returns non-zero so the caller rolls back both.
APPLY_FAIL_REASON=""
apply_ruleset() {
    local rules_json="$1" count i rule action proto port source family fam
    APPLY_FAIL_REASON=""
    flush_chain
    count=$(echo "${rules_json}" | jq 'length')
    for (( i = 0; i < count; i++ )); do
        rule=$(echo "${rules_json}" | jq -c ".[${i}]")
        action=$(echo "${rule}" | jq -r '.action')
        proto=$(echo "${rule}" | jq -r '.proto')
        port=$(echo "${rule}" | jq -r '.port')
        source=$(echo "${rule}" | jq -r '.source // "null"')
        family=$(echo "${rule}" | jq -r '.family // "both"')
        for fam in 4 6; do
            case "${family}" in
                both) : ;;
                "${fam}") : ;;
                *) continue ;;
            esac
            if [ "${fam}" = "6" ] && [ "${IPV6_SUPPORTED}" -ne 1 ]; then
                continue
            fi
            if ! apply_rule "${fam}" "${action}" "${proto}" "${port}" "${source}"; then
                APPLY_FAIL_REASON="rule ${i} (${action} ${proto}/${port} family ${fam}) failed to apply in $(ipt_bin_for "${fam}")"
                bashio::log.error "Firewall: ${APPLY_FAIL_REASON}."
                return 1
            fi
        done
    done
    return 0
}

# known_rules is the real union of both chains, one entry per table a rule is live in.
chain_rules_lines() {
    local family="$1" bin
    bin=$(ipt_bin_for "${family}")
    "${bin}" -S "${CHAIN}" 2>/dev/null | awk -v chain="${CHAIN}" -v family="${family}" '
        $1 == "-A" && $2 == chain {
            proto = ""; port = ""; source = ""; target = "ACCEPT"
            for (i = 3; i <= NF; i++) {
                if ($i == "-p") { proto = $(i + 1) }
                else if ($i == "-s") { source = $(i + 1) }
                else if ($i == "--dport") { port = $(i + 1) }
                else if ($i == "-j") { target = $(i + 1) }
            }
            action = (target == "ACCEPT") ? "allow" : "deny"
            src_json = (source == "") ? "null" : "\"" source "\""
            printf "{\"action\":\"%s\",\"proto\":\"%s\",\"port\":%s,\"source\":%s,\"family\":\"%s\"}\n", action, proto, port, src_json, family
        }
    '
}

known_rules_json() {
    local lines
    lines=$(chain_rules_lines 4)
    if [ "${IPV6_SUPPORTED}" -eq 1 ]; then
        lines=$(printf '%s\n%s' "${lines}" "$(chain_rules_lines 6)")
    fi
    lines=$(printf '%s' "${lines}" | grep -v '^$' || true)
    if [ -z "${lines}" ]; then
        echo "[]"
    else
        echo "${lines}" | jq -s -c '.'
    fi
}

# Prints the HTTP code; "000" means the socket is unreachable (no docker_api, or Protection Mode on).
docker_update() {
    local container="$1" body="$2"
    curl -sS -o /tmp/ha_soc_docker_resp -w '%{http_code}' \
        --unix-socket "${DOCKER_SOCK}" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "${body}" \
        "http://localhost/containers/${container}/update" 2>/dev/null || echo "000"
}

# Applies LIMITS_FILE caps and reports per-slug state; never exits non-zero, a failed cap is reported.
apply_resource_limits() {
    local limits prev_slugs slug entry body code status detail state_entries raw_limits raw_prev
    raw_limits=$(cat "${LIMITS_FILE}" 2>/dev/null || echo "{}")
    if ! limits=$(printf '%s' "${raw_limits}" | validate_resource_limits); then
        bashio::log.error "Resource caps: rejecting an invalid persisted limit document; no Docker updates were attempted."
        return 0
    fi
    raw_prev=$(cat "${LIMITS_FILE}.applied" 2>/dev/null || echo "[]")
    if ! prev_slugs=$(printf '%s' "${raw_prev}" | validate_applied_resource_slugs); then
        bashio::log.warning "Resource caps: ignoring an invalid previously-applied slug list."
        prev_slugs="[]"
    fi
    state_entries="{}"

    # Quoted read loops only; an unquoted for over jq output would word-split a hostile slug.
    if [ ! -S "${DOCKER_SOCK}" ]; then
        # Socket not mapped at all: docker_api not granted (or old config).
        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in delivered limits."
                continue
            fi
            state_entries=$(echo "${state_entries}" | jq -c --arg s "${slug}" \
                '. + {($s): {status: "denied", detail: "Docker socket not available — enable docker_api and disable Protection Mode on the HA SOC Probe add-on."}}')
        done < <(echo "${limits}" | jq -r 'keys[]')
    else
        # 0 for Memory/MemorySwap/NanoCpus means unlimited to Docker.
        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in the previously-applied list."
                continue
            fi
            if [ "$(echo "${limits}" | jq --arg s "${slug}" 'has($s)')" = "false" ]; then
                docker_update "addon_${slug}" '{"Memory":0,"MemorySwap":0,"NanoCpus":0,"CpuShares":0}' >/dev/null
                bashio::log.info "Resource caps removed for addon_${slug} — reset to unlimited."
            fi
        done < <(echo "${prev_slugs}" | jq -r '.[]')

        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in delivered limits."
                continue
            fi
            entry=$(echo "${limits}" | jq -c --arg s "${slug}" '.[$s]')
            # MemorySwap must equal Memory or Docker rejects the update.
            body=$(printf '%s' "${entry}" | docker_body_for_resource_limit)
            code=$(docker_update "addon_${slug}" "${body}")
            case "${code}" in
                200) status="applied"; detail="" ;;
                404) status="failed"; detail="container addon_${slug} not found" ;;
                000) status="denied"; detail="Docker socket rejected the connection — is Protection Mode disabled on the HA SOC Probe add-on?" ;;
                *)   status="failed"; detail="docker update returned HTTP ${code}: $(head -c 200 /tmp/ha_soc_docker_resp 2>/dev/null)" ;;
            esac
            state_entries=$(echo "${state_entries}" | jq -c --arg s "${slug}" --arg st "${status}" --arg d "${detail}" \
                '. + {($s): {status: $st, detail: (if $d == "" then null else $d end)}}')
        done < <(echo "${limits}" | jq -r 'keys[]')
    fi

    echo "${limits}" | jq -c 'keys' > "${LIMITS_FILE}.applied"

    if [ "$(echo "${state_entries}" | jq 'length')" != "0" ]; then
        payload=$(jq -n \
            --argjson state "${state_entries}" \
            --arg probe_secret "${PROBE_SECRET}" \
            '{resource_limit_state: $state, probe_secret: $probe_secret}')
        curl -sS -o /dev/null \
            -X POST \
            -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H "Content-Type: application/json" \
            -d "${payload}" \
            "${INGEST_URL}" 2>/dev/null || true
    fi
}

# Reason is truncated to REASON_MAX_CHARS so Core's schema does not reject the report.
report_resolution() {
    local test_id="$1" status="$2" reason="${3:-}" payload
    probe_ipv6_supported
    reason="$(printf '%s' "${reason}" | head -c "${REASON_MAX_CHARS}")"
    payload=$(jq -n \
        --argjson known_rules "$(known_rules_json)" \
        --argjson ipv6_supported "$(ipv6_supported_json)" \
        --arg test_id "${test_id}" \
        --arg status "${status}" \
        --arg reason "${reason}" \
        --arg probe_secret "${PROBE_SECRET}" \
        '{firewall_known_rules: $known_rules, firewall_ipv6_supported: $ipv6_supported, firewall_resolved_test_id: $test_id, firewall_resolved_status: $status, firewall_resolved_reason: (if $reason == "" then null else $reason end), probe_secret: $probe_secret}')
    curl -sS -o /dev/null -w '%{http_code}\n' \
        -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${INGEST_URL}" >/tmp/ha_soc_fw_report_code 2>/dev/null || true
    bashio::log.info "Reported firewall test ${test_id} as ${status} to HA SOC (HTTP $(cat /tmp/ha_soc_fw_report_code 2>/dev/null || echo '?'))."
}

# Chain-scoped: flush and replay the snapshot; never iptables-restore over a whole table.
replay_chain_backup() {
    local family="$1" chain_backup_path="$2" line bin
    bin=$(ipt_bin_for "${family}")
    "${bin}" -F "${CHAIN}" || true
    while IFS= read -r line; do
        case "${line}" in
            "-A ${CHAIN} "*)
                # Unquoted on purpose: the line is iptables' own -S output for a rule this script wrote; no argument contains whitespace.
                # shellcheck disable=SC2086
                if ! "${bin}" ${line}; then
                    bashio::log.error "Firewall: could not replay snapshot line '${line}' via ${bin}."
                fi
                ;;
            *)
                :
                ;;
        esac
    done < "${chain_backup_path}"
}

# Safe on an already-resolved test: the timer, startup recovery, and the finish script all call this.
revert_test() {
    local test_id="$1" reason="${2:-}" chain_backup_path chain6_backup_path resolved_marker reverted_any=0
    chain_backup_path=$(chain_backup_path_for "${test_id}")
    chain6_backup_path=$(chain6_backup_path_for "${test_id}")
    resolved_marker=$(resolved_marker_for "${test_id}")

    if [ -e "${resolved_marker}" ]; then
        return 0
    fi
    touch "${resolved_marker}"
    probe_ipv6_supported

    if [ -r "${chain_backup_path}" ]; then
        replay_chain_backup 4 "${chain_backup_path}"
        reverted_any=1
    else
        bashio::log.error "Firewall test ${test_id} needs reverting but its IPv4 chain snapshot (${chain_backup_path}) is missing; leaving that chain as-is rather than guessing. This should not happen; the full-table dump next to it, if present, is available for manual recovery."
    fi
    if [ "${IPV6_SUPPORTED}" -eq 1 ]; then
        if [ -r "${chain6_backup_path}" ]; then
            replay_chain_backup 6 "${chain6_backup_path}"
            reverted_any=1
        else
            # Parity with the IPv4 missing-snapshot path; guessing a chain state is worse than saying so.
            bashio::log.error "Firewall test ${test_id}: no IPv6 chain snapshot (${chain6_backup_path}); leaving the ip6tables chain as-is rather than guessing."
        fi
    fi
    if [ "${reverted_any}" -eq 1 ]; then
        bashio::log.warning "Firewall test ${test_id} was not confirmed in time; reverted the ${CHAIN} chain(s) to their pre-test contents."
    fi
    report_resolution "${test_id}" "reverted" "${reason}"
}

confirm_test() {
    local test_id="$1" resolved_marker
    resolved_marker=$(resolved_marker_for "${test_id}")
    if [ -e "${resolved_marker}" ]; then
        return 0
    fi
    touch "${resolved_marker}"
    report_resolution "${test_id}" "confirmed"
}

# Armed the instant a ruleset is applied, independent of any later poll or network call.
arm_revert_timer() {
    local test_id="$1" window_seconds="$2"
    (
        sleep "${window_seconds}"
        revert_test "${test_id}"
    ) &
    disown
}

# The trap only sets a flag; the finish script owns stop-time revert.
on_stop_signal() {
    STOP_REQUESTED=1
}
trap on_stop_signal TERM INT

# `wait` returns the moment the trap runs; a foreground sleep would not.
interruptible_sleep() {
    sleep "$1" &
    wait $! 2>/dev/null || true
}

exit_if_stop_requested() {
    if [ "${STOP_REQUESTED}" -eq 1 ]; then
        bashio::log.info "HA SOC Probe firewall poller received a stop signal; exiting cleanly. The finish script reverts any armed test."
        exit 0
    fi
}

mkdir -p "${STATE_DIR}"
ensure_probe_secret
probe_ipv6_supported
ensure_chain
if [ "${IPV6_SUPPORTED}" -ne 1 ]; then
    bashio::log.warning "ip6tables is not functional on this host; IPv6 halves of firewall rules will be skipped and reported as such (firewall_ipv6_supported=false)."
fi

if [ -s "${CURRENT_TEST_FILE}" ]; then
    stale_test_id=$(cat "${CURRENT_TEST_FILE}")
    resolved_marker=$(resolved_marker_for "${stale_test_id}")
    if [ ! -e "${resolved_marker}" ]; then
        bashio::log.warning "Found an unresolved firewall test (${stale_test_id}) left over from a previous run — reverting it now rather than trusting a timer that died with that process."
        revert_test "${stale_test_id}"
    fi
fi
: > "${CURRENT_TEST_FILE}"

bashio::log.info "HA SOC Probe firewall poller starting — checking for pending firewall work every ${POLL_INTERVAL_SECONDS}s."

poll_counter=0

while true; do
    exit_if_stop_requested
    current_test_id=$(cat "${CURRENT_TEST_FILE}" 2>/dev/null || echo "")

    # The timer resolves a test without clearing this file; clear a resolved id here or Core's one-test gate wedges.
    if [ -n "${current_test_id}" ] && [ -e "$(resolved_marker_for "${current_test_id}")" ]; then
        : > "${CURRENT_TEST_FILE}"
        current_test_id=""
    fi

    payload=$(jq -n \
        --arg current_test_id "${current_test_id}" \
        --arg probe_secret "${PROBE_SECRET}" \
        '{current_test_id: $current_test_id, probe_secret: $probe_secret}')
    response=$(curl -sS -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${POLL_URL}" 2>/dev/null || echo "")

    action=$(echo "${response}" | jq -r '.service_response.action // "none"' 2>/dev/null || echo "none")

    case "${action}" in
        apply)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            rules_json=$(echo "${response}" | jq -c '.service_response.rules')
            window_seconds=$(echo "${response}" | jq -r '.service_response.window_seconds')

            # Fresh read of the state file: never arm a second test while one is unresolved.
            held_test_id=$(cat "${CURRENT_TEST_FILE}" 2>/dev/null || echo "")
            if [ -n "${held_test_id}" ] && [ ! -e "$(resolved_marker_for "${held_test_id}")" ]; then
                bashio::log.warning "Firewall: refusing to apply test B while test A is still armed (held ${held_test_id}, offered ${test_id})."
            elif ! valid_slug "${test_id}"; then
                # The id becomes /data file names; refuse anything not slug-shaped (no report is possible for it).
                bashio::log.error "Firewall: refusing a delivered test id that is not a plain lowercase token."
            elif ! valid_window "${window_seconds}"; then
                bashio::log.error "Firewall test ${test_id}: window_seconds ${window_seconds} is outside ${WINDOW_MIN_SECONDS}-${WINDOW_MAX_SECONDS}; refusing to apply."
                touch "$(resolved_marker_for "${test_id}")"
                report_resolution "${test_id}" "reverted" "rejected by add-on: window_seconds out of bounds"
            elif ! validate_ruleset "${rules_json}"; then
                bashio::log.error "Firewall test ${test_id}: ${RULES_REJECT_REASON}; refusing to apply. The live ruleset is untouched."
                touch "$(resolved_marker_for "${test_id}")"
                report_resolution "${test_id}" "reverted" "${RULES_REJECT_REASON}"
            else
                probe_ipv6_supported
                # Re-ensure chains here: ip6tables support can appear after startup and the snapshot would fail spuriously.
                ensure_chain
                bashio::log.info "Applying proposed firewall ruleset (test ${test_id}, ${window_seconds}s to confirm)."
                # Any backup failure refuses the whole test; nothing has touched the chains yet, so it reports reverted/backup_failed.
                backups_ok=1
                iptables-save -t filter > "$(backup_path_for "${test_id}")" || backups_ok=0
                iptables -S "${CHAIN}" > "$(chain_backup_path_for "${test_id}")" || backups_ok=0
                if [ "${IPV6_SUPPORTED}" -eq 1 ]; then
                    ip6tables-save -t filter > "$(backup6_path_for "${test_id}")" || backups_ok=0
                    ip6tables -S "${CHAIN}" > "$(chain6_backup_path_for "${test_id}")" || backups_ok=0
                fi
                if [ "${backups_ok}" -ne 1 ]; then
                    bashio::log.error "Firewall test ${test_id}: pre-test backup failed (backup_failed); refusing to apply. The live ruleset is untouched."
                    touch "$(resolved_marker_for "${test_id}")"
                    report_resolution "${test_id}" "reverted" "backup_failed"
                else
                    echo -n "${test_id}" > "${CURRENT_TEST_FILE}"
                    if apply_ruleset "${rules_json}"; then
                        arm_revert_timer "${test_id}" "${window_seconds}"
                    else
                        # Roll back both chains from their snapshots; never a whole-table restore.
                        bashio::log.error "Firewall test ${test_id} failed to apply cleanly; replaying both pre-test chain snapshots."
                        replay_chain_backup 4 "$(chain_backup_path_for "${test_id}")" || true
                        if [ "${IPV6_SUPPORTED}" -eq 1 ] && [ -r "$(chain6_backup_path_for "${test_id}")" ]; then
                            replay_chain_backup 6 "$(chain6_backup_path_for "${test_id}")" || true
                        fi
                        touch "$(resolved_marker_for "${test_id}")"
                        report_resolution "${test_id}" "reverted" "${APPLY_FAIL_REASON}"
                        : > "${CURRENT_TEST_FILE}"
                    fi
                fi
            fi
            ;;
        confirm)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            # Same token allowlist as apply: the id becomes file names.
            if valid_slug "${test_id}"; then
                confirm_test "${test_id}"
                : > "${CURRENT_TEST_FILE}"
            else
                bashio::log.error "Firewall: refusing a delivered confirm for a test id that is not a plain lowercase token."
            fi
            ;;
        revert)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            if valid_slug "${test_id}"; then
                revert_test "${test_id}"
                : > "${CURRENT_TEST_FILE}"
            else
                bashio::log.error "Firewall: refusing a delivered revert for a test id that is not a plain lowercase token."
            fi
            ;;
        *)
            :
            ;;
    esac

    # Re-applied every ~60s because Supervisor recreates containers on update/restart.
    new_limits=$(echo "${response}" | jq -c '.service_response.resource_limits.limits // empty' 2>/dev/null || echo "")
    if [ -n "${new_limits}" ]; then
        if ! new_limits=$(printf '%s' "${new_limits}" | validate_resource_limits); then
            bashio::log.error "Resource caps: rejecting an invalid limit document delivered by Core; the last valid set remains active."
        else
            old_limits=$(cat "${LIMITS_FILE}" 2>/dev/null || echo "{}")
            if [ "${new_limits}" != "${old_limits}" ]; then
                printf '%s\n' "${new_limits}" > "${LIMITS_FILE}"
                bashio::log.info "Resource cap set changed — applying now."
                apply_resource_limits
            fi
        fi
    elif [ -s "${LIMITS_FILE}" ] && [ "$(cat "${LIMITS_FILE}")" != "{}" ]; then
        # Core no longer sends any caps: clear ours (resets containers).
        echo "{}" > "${LIMITS_FILE}"
        bashio::log.info "All resource caps cleared by HA SOC — resetting containers."
        apply_resource_limits
    fi
    poll_counter=$(( poll_counter + 1 ))
    if [ $(( poll_counter % LIMIT_APPLY_EVERY )) -eq 0 ] \
        && [ -s "${LIMITS_FILE}" ] && [ "$(cat "${LIMITS_FILE}")" != "{}" ]; then
        apply_resource_limits
    fi

    exit_if_stop_requested
    interruptible_sleep "${POLL_INTERVAL_SECONDS}"
    exit_if_stop_requested
done

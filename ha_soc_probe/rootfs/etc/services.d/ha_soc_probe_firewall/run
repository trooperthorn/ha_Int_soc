#!/usr/bin/with-contenv bashio
# ==============================================================================
# HA SOC Probe — firewall command poller.
#
# This is the ONLY thing in this add-on that ever mutates host state — see
# the HA SOC integration's firewall.py module docstring for the full
# read/write design. This script's job is narrow and specific:
#
#   1. Poll ha_soc.poll_firewall_command every POLL_INTERVAL_SECONDS for a
#      pending apply/confirm/revert instruction.
#   2. On "apply": take TWO backups and check both succeeded (work item
#      2.3): a full filter-table dump (iptables-save -t filter, kept for
#      manual recovery only) and a chain-only snapshot (iptables -S
#      HA_SOC_RULES, the one the revert actually replays). If either
#      backup fails, the test is refused outright: nothing is applied and
#      the test is reported back as reverted (the reason, backup_failed,
#      lives in this log because the report protocol carries a status
#      only). Otherwise replace the contents of the dedicated HA_SOC_RULES
#      chain with the proposed rules and arm a LOCAL, self-contained
#      revert timer, a plain `sleep N` backgrounded from this same
#      process, not a cron job or a call back out to Home Assistant. This
#      is the one property that actually matters: if the new rules break
#      the very network path this add-on (or Home Assistant Core) needs to
#      reach anything else, the revert still has to happen, and nothing
#      here depends on that broken path working again to make it happen.
#   3. On "confirm"/"revert": mark the test resolved (making the armed
#      timer from step 2 a no-op when it wakes) and report back
#      immediately via ha_soc.ingest_probe_result, rather than waiting for
#      the next slow port-scan cycle to say so.
#   4. On startup: if a previous run left an unresolved test behind (this
#      process crashed or the add-on was restarted mid-window — the local
#      timer from step 2 dies with the process that armed it), restore its
#      backup immediately. An unresolved test found at startup is treated
#      as failed, not as "still in progress" — there is no way to know how
#      long its window has already been open, so the only safe assumption
#      is the same one this whole feature exists to make automatic: when
#      in doubt, go back to the last known-good state.
#
# Every rule this ever applies lives in one chain this project owns
# outright (HA_SOC_RULES) — never the raw INPUT chain, never anything
# Docker itself manages. A revert is chain-scoped for the same reason
# (work item 2.3): it flushes HA_SOC_RULES and replays the chain snapshot
# into it, and never runs `iptables-restore` over the whole table, because
# a whole-table restore would also roll back every rule Docker or the host
# changed since the snapshot was taken. The full filter-table dump that is
# still written before every apply exists purely so a human has something
# to recover from by hand if everything else fails.
# ==============================================================================
set -uo pipefail

CHAIN="HA_SOC_RULES"
STATE_DIR="/data"
CURRENT_TEST_FILE="${STATE_DIR}/ha_soc_fw_current_test_id"
# Shared with the port-scanner service (both live in this same container, so
# /data is shared). Whichever service starts first creates it; the other
# reads the same value. See ensure_probe_secret.
SECRET_FILE="${STATE_DIR}/ha_soc_probe_secret"
POLL_URL="http://supervisor/core/api/services/ha_soc/poll_firewall_command?return_response"
INGEST_URL="http://supervisor/core/api/services/ha_soc/ingest_probe_result"
POLL_INTERVAL_SECONDS=5
PROBE_SECRET=""

# Full filter-table dump, kept for MANUAL recovery only; no code path
# ever feeds it back to iptables-restore (see the header and work item 2.3).
backup_path_for() { echo "${STATE_DIR}/ha_soc_fw_backup_${1}.rules"; }
# Chain-only snapshot (iptables -S HA_SOC_RULES), the thing a revert replays.
chain_backup_path_for() { echo "${STATE_DIR}/ha_soc_fw_chain_${1}.rules"; }
resolved_marker_for() { echo "${STATE_DIR}/ha_soc_fw_resolved_${1}"; }

# The add-on's local copy of the integration's add-on slug schema (work
# item 2.2, resource_watchdog.ADDON_SLUG_PATTERN). Core validates slugs at
# its WS layer too, but this end revalidates before building any Docker
# URL from one, so a compromised or buggy Core still cannot smuggle path
# or query syntax into "http://localhost/containers/addon_<slug>/update".
valid_slug() {
    printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,63}$'
}

# --- Resource hard caps (Docker) ----------------------------------------------
# Owner-configured per-add-on Docker limits (--memory / --cpus equivalents),
# delivered on the same poll channel as firewall work and applied against the
# Docker socket. Requires config.yaml's `docker_api: true` AND this add-on's
# Protection Mode DISABLED — with protection on, the socket is read-only and
# every apply reports "denied" (surfaced verbatim in the HA SOC panel) rather
# than pretending. Because Supervisor recreates containers on add-on
# update/restart (silently dropping any limit), the current caps are
# re-applied every LIMIT_APPLY_EVERY poll cycles (~60s) — idempotent, cheap,
# and the only way caps survive the platform's own lifecycle.
DOCKER_SOCK="/var/run/docker.sock"
LIMITS_FILE="${STATE_DIR}/ha_soc_resource_limits.json"
LIMIT_APPLY_EVERY=12  # x POLL_INTERVAL_SECONDS = ~60s

# Create the per-install probe secret once (atomically, so the two services
# racing to create it can't end up with two different values; noclobber
# makes the redirect fail for the loser, who then reads the winner's file),
# then load it. Core requires the Supervisor proxy's own user context AND
# this secret on every inbound call: it pins the first secret presented on
# an authenticated call and rejects any later call that can't present a
# match, so a forged local service call can't spoof a firewall report.
ensure_probe_secret() {
    if [ ! -s "${SECRET_FILE}" ]; then
        ( set -o noclobber
          umask 077
          head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1 > "${SECRET_FILE}"
        ) 2>/dev/null || true
    fi
    # Tighten a pre-existing file too; the first live verification run
    # found it at 0644 (see the scanner service's twin comment).
    chmod 600 "${SECRET_FILE}" 2>/dev/null || true
    PROBE_SECRET="$(cat "${SECRET_FILE}" 2>/dev/null || echo "")"
}

# --- Chain management --------------------------------------------------------

# Creates the dedicated chain if needed and jumps INPUT into it. The jump
# is inserted at POSITION 1 of INPUT (`iptables -I` with no index inserts
# at the top), ahead of Docker's rules and anything the host already had,
# and that position is the point: a deny that sits below an accept is not
# a deny, because iptables stops at the first matching rule. If the jump
# sat after a broad accept, every deny this feature applies would be
# cosmetic while the panel claimed it was enforced.
#
# Uninstall: the Supervisor offers no verified hook that runs on add-on
# uninstall (work plan section 6.2, UNVERIFIED), so removal of the chain
# and this jump is best-effort only. A clean uninstall leaves an empty
# HA_SOC_RULES chain and one INPUT jump behind, which is inert; the add-on
# documentation describes the two-command manual cleanup.
ensure_chain() {
    iptables -N "${CHAIN}" 2>/dev/null || true
    if ! iptables -C INPUT -j "${CHAIN}" 2>/dev/null; then
        iptables -I INPUT -j "${CHAIN}"
    fi
}

flush_chain() {
    iptables -F "${CHAIN}" 2>/dev/null || true
}

# One proposed rule (JSON object: action/proto/port/source) -> one iptables
# append onto the dedicated chain. "source" absent/null means "any source".
# Returns iptables' own exit status so the caller can tell a rule silently
# failed to apply rather than assuming success.
apply_rule() {
    local action="$1" proto="$2" port="$3" source="$4" target="ACCEPT"
    [ "${action}" = "deny" ] && target="DROP"
    if [ -n "${source}" ] && [ "${source}" != "null" ]; then
        iptables -A "${CHAIN}" -s "${source}" -p "${proto}" --dport "${port}" -j "${target}"
    else
        iptables -A "${CHAIN}" -p "${proto}" --dport "${port}" -j "${target}"
    fi
}

# Replaces the chain's entire contents with the proposed ruleset (a JSON
# array). Flush-then-apply, never incremental — a proposed ruleset is
# always the FULL desired state, not a diff. Returns non-zero if ANY rule
# failed to apply, so a partially-applied ruleset is treated as a failure
# (and rolled back by the caller) rather than silently left half-live while
# the operator believes the whole set is enforced.
apply_ruleset() {
    local rules_json="$1" count i rule action proto port source
    flush_chain
    count=$(echo "${rules_json}" | jq 'length')
    for (( i = 0; i < count; i++ )); do
        rule=$(echo "${rules_json}" | jq -c ".[${i}]")
        action=$(echo "${rule}" | jq -r '.action')
        proto=$(echo "${rule}" | jq -r '.proto')
        port=$(echo "${rule}" | jq -r '.port')
        source=$(echo "${rule}" | jq -r '.source // "null"')
        if ! apply_rule "${action}" "${proto}" "${port}" "${source}"; then
            bashio::log.error "Firewall: rule ${i} (${action} ${proto}/${port} from ${source}) failed to apply."
            return 1
        fi
    done
    return 0
}

# The chain's current, real contents, translated back into the same
# {action, proto, port, source} shape the integration proposes rules in —
# what Core displays as "known_rules" is always this, never Core's own
# optimistic memory of what it last proposed.
known_rules_json() {
    local lines
    lines=$(
        iptables -S "${CHAIN}" 2>/dev/null | awk -v chain="${CHAIN}" '
            $1 == "-A" && $2 == chain {
                proto = ""; port = ""; source = ""; target = "ACCEPT"
                for (i = 3; i <= NF; i++) {
                    if ($i == "-p") { proto = $(i + 1) }
                    else if ($i == "-s") { source = $(i + 1) }
                    else if ($i == "--dport") { port = $(i + 1) }
                    else if ($i == "-j") { target = $(i + 1) }
                }
                action = (target == "ACCEPT") ? "allow" : "deny"
                src_json = (source == "") ? "null" : "\"" source "\""
                printf "{\"action\":\"%s\",\"proto\":\"%s\",\"port\":%s,\"source\":%s}\n", action, proto, port, src_json
            }
        '
    )
    if [ -z "${lines}" ]; then
        echo "[]"
    else
        echo "${lines}" | jq -s -c '.'
    fi
}

# One docker-socket update for one container. Args: container name, then the
# JSON body. Prints the HTTP status code ("000" when the socket itself is
# unreachable — no docker_api grant, or Protection Mode still enabled).
docker_update() {
    local container="$1" body="$2"
    curl -sS -o /tmp/ha_soc_docker_resp -w '%{http_code}' \
        --unix-socket "${DOCKER_SOCK}" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "${body}" \
        "http://localhost/containers/${container}/update" 2>/dev/null || echo "000"
}

# Applies the current caps (LIMITS_FILE: {slug: {memory_mb, cpus}}) to every
# targeted container, resets containers whose cap was removed since the last
# pass, and reports per-slug state back to Core via ingest_probe_result.
# Never exits non-zero — a cap that can't be applied is REPORTED, not fatal.
apply_resource_limits() {
    local limits prev_slugs slug entry memory_mb cpus body code status detail state_entries
    limits=$(cat "${LIMITS_FILE}" 2>/dev/null || echo "{}")
    prev_slugs=$(cat "${LIMITS_FILE}.applied" 2>/dev/null || echo "[]")
    state_entries="{}"

    # Every slug loop below is a quoted `while IFS= read -r` over jq output
    # (work item 2.2), never an unquoted `for $(...)`: an unquoted loop
    # word-splits and glob-expands whatever a compromised Core put in the
    # delivered JSON, and each slug is additionally revalidated against the
    # shared slug regex before any Docker URL is built from it.
    if [ ! -S "${DOCKER_SOCK}" ]; then
        # Socket not mapped at all — docker_api not granted (or old config).
        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in delivered limits."
                continue
            fi
            state_entries=$(echo "${state_entries}" | jq -c --arg s "${slug}" \
                '. + {($s): {status: "denied", detail: "Docker socket not available — enable docker_api and disable Protection Mode on the HA SOC Probe add-on."}}')
        done < <(echo "${limits}" | jq -r 'keys[]')
    else
        # Reset any container whose cap was removed since the last pass —
        # 0 for Memory/MemorySwap/NanoCpus means "unlimited" to Docker.
        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in the previously-applied list."
                continue
            fi
            if [ "$(echo "${limits}" | jq --arg s "${slug}" 'has($s)')" = "false" ]; then
                docker_update "addon_${slug}" '{"Memory":0,"MemorySwap":0,"NanoCpus":0,"CpuShares":0}' >/dev/null
                bashio::log.info "Resource caps removed for addon_${slug} — reset to unlimited."
            fi
        done < <(echo "${prev_slugs}" | jq -r '.[]')

        while IFS= read -r slug; do
            if ! valid_slug "${slug}"; then
                bashio::log.error "Resource caps: ignoring invalid add-on slug in delivered limits."
                continue
            fi
            entry=$(echo "${limits}" | jq -c --arg s "${slug}" '.[$s]')
            memory_mb=$(echo "${entry}" | jq -r '.memory_mb // empty')
            cpus=$(echo "${entry}" | jq -r '.cpus // empty')
            # Memory cap implies the swap cap too (MemorySwap = Memory):
            # without it Docker rejects the update, and a cap that the
            # container can dodge by swapping isn't a cap.
            body="{}"
            if [ -n "${memory_mb}" ]; then
                body=$(echo "${body}" | jq -c --argjson b "$(( memory_mb * 1024 * 1024 ))" '. + {Memory: $b, MemorySwap: $b}')
            fi
            if [ -n "${cpus}" ]; then
                body=$(echo "${body}" | jq -c --argjson n "$(awk -v c="${cpus}" 'BEGIN{printf "%.0f", c * 1000000000}')" '. + {NanoCpus: $n}')
            fi
            code=$(docker_update "addon_${slug}" "${body}")
            case "${code}" in
                200) status="applied"; detail="" ;;
                404) status="failed"; detail="container addon_${slug} not found" ;;
                000) status="denied"; detail="Docker socket rejected the connection — is Protection Mode disabled on the HA SOC Probe add-on?" ;;
                *)   status="failed"; detail="docker update returned HTTP ${code}: $(head -c 200 /tmp/ha_soc_docker_resp 2>/dev/null)" ;;
            esac
            state_entries=$(echo "${state_entries}" | jq -c --arg s "${slug}" --arg st "${status}" --arg d "${detail}" \
                '. + {($s): {status: $st, detail: (if $d == "" then null else $d end)}}')
        done < <(echo "${limits}" | jq -r 'keys[]')
    fi

    echo "${limits}" | jq -c 'keys' > "${LIMITS_FILE}.applied"

    if [ "$(echo "${state_entries}" | jq 'length')" != "0" ]; then
        payload=$(jq -n \
            --argjson state "${state_entries}" \
            --arg probe_secret "${PROBE_SECRET}" \
            '{resource_limit_state: $state, probe_secret: $probe_secret}')
        curl -sS -o /dev/null \
            -X POST \
            -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H "Content-Type: application/json" \
            -d "${payload}" \
            "${INGEST_URL}" 2>/dev/null || true
    fi
}

# --- Reporting back to Core ---------------------------------------------------

report_resolution() {
    local test_id="$1" status="$2" payload
    payload=$(jq -n \
        --argjson known_rules "$(known_rules_json)" \
        --arg test_id "${test_id}" \
        --arg status "${status}" \
        --arg probe_secret "${PROBE_SECRET}" \
        '{firewall_known_rules: $known_rules, firewall_resolved_test_id: $test_id, firewall_resolved_status: $status, probe_secret: $probe_secret}')
    curl -sS -o /dev/null -w '%{http_code}\n' \
        -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${INGEST_URL}" >/tmp/ha_soc_fw_report_code 2>/dev/null || true
    bashio::log.info "Reported firewall test ${test_id} as ${status} to HA SOC (HTTP $(cat /tmp/ha_soc_fw_report_code 2>/dev/null || echo '?'))."
}

# Chain-scoped revert (work item 2.3): flush HA_SOC_RULES, then replay the
# pre-test chain snapshot into it, one `-A HA_SOC_RULES ...` line at a
# time; the snapshot's `-N` line is skipped because the chain already
# exists. Never `iptables-restore` here: a whole-table restore would also
# roll back every rule Docker or the host changed since the snapshot.
replay_chain_backup() {
    local chain_backup_path="$1" line
    iptables -F "${CHAIN}" || true
    while IFS= read -r line; do
        case "${line}" in
            "-A ${CHAIN} "*)
                # Unquoted expansion is deliberate: the line is iptables'
                # own -S output for a rule this script itself wrote
                # (action/proto/port/source only), so splitting it on
                # whitespace reconstructs exactly the arguments to append,
                # and none of those arguments can contain whitespace.
                # shellcheck disable=SC2086
                if ! iptables ${line}; then
                    bashio::log.error "Firewall: could not replay snapshot line '${line}'."
                fi
                ;;
            *)
                :
                ;;
        esac
    done < "${chain_backup_path}"
}

# Reverts the chain to the pre-test snapshot for a test_id and marks it
# resolved, unless something else (a "confirm", or an earlier revert)
# already resolved it, checked right before restoring, since this is
# called from the armed local timer, from the startup crash-recovery check
# below, AND from the finish script's stop-time recovery, and all of them
# must be safe to call on an already-resolved test (a no-op).
revert_test() {
    local test_id="$1" chain_backup_path resolved_marker
    chain_backup_path=$(chain_backup_path_for "${test_id}")
    resolved_marker=$(resolved_marker_for "${test_id}")

    if [ -e "${resolved_marker}" ]; then
        return 0
    fi
    touch "${resolved_marker}"

    if [ -r "${chain_backup_path}" ]; then
        replay_chain_backup "${chain_backup_path}"
        bashio::log.warning "Firewall test ${test_id} was not confirmed in time; reverted the ${CHAIN} chain to its pre-test contents."
    else
        bashio::log.error "Firewall test ${test_id} needs reverting but its chain snapshot (${chain_backup_path}) is missing; leaving the chain as-is rather than guessing. This should not happen; the full-table dump next to it, if present, is available for manual recovery."
    fi
    report_resolution "${test_id}" "reverted"
}

confirm_test() {
    local test_id="$1" resolved_marker
    resolved_marker=$(resolved_marker_for "${test_id}")
    if [ -e "${resolved_marker}" ]; then
        return 0
    fi
    touch "${resolved_marker}"
    report_resolution "${test_id}" "confirmed"
}

# The local safety net: armed the instant a ruleset is applied, entirely
# independent of any further poll cycle or network round-trip succeeding.
arm_revert_timer() {
    local test_id="$1" window_seconds="$2"
    (
        sleep "${window_seconds}"
        revert_test "${test_id}"
    ) &
    disown
}

# --- Startup ------------------------------------------------------------------

mkdir -p "${STATE_DIR}"
ensure_probe_secret
ensure_chain

if [ -s "${CURRENT_TEST_FILE}" ]; then
    stale_test_id=$(cat "${CURRENT_TEST_FILE}")
    resolved_marker=$(resolved_marker_for "${stale_test_id}")
    if [ ! -e "${resolved_marker}" ]; then
        bashio::log.warning "Found an unresolved firewall test (${stale_test_id}) left over from a previous run — reverting it now rather than trusting a timer that died with that process."
        revert_test "${stale_test_id}"
    fi
fi
: > "${CURRENT_TEST_FILE}"

bashio::log.info "HA SOC Probe firewall poller starting — checking for pending firewall work every ${POLL_INTERVAL_SECONDS}s."

# --- Main poll loop -------------------------------------------------------

poll_counter=0

while true; do
    current_test_id=$(cat "${CURRENT_TEST_FILE}" 2>/dev/null || echo "")

    # The poll's current_test_id means "the test this add-on is still armed
    # for". The backgrounded revert timer resolves a test without clearing
    # this file (it only creates the resolved marker), so a resolved id is
    # cleared here before it is reported. Without this, Core's one-test-at-
    # a-time gate would read the stale id as a still-armed test and refuse
    # to hand over the next apply forever.
    if [ -n "${current_test_id}" ] && [ -e "$(resolved_marker_for "${current_test_id}")" ]; then
        : > "${CURRENT_TEST_FILE}"
        current_test_id=""
    fi

    payload=$(jq -n \
        --arg current_test_id "${current_test_id}" \
        --arg probe_secret "${PROBE_SECRET}" \
        '{current_test_id: $current_test_id, probe_secret: $probe_secret}')
    response=$(curl -sS -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${POLL_URL}" 2>/dev/null || echo "")

    action=$(echo "${response}" | jq -r '.service_response.action // "none"' 2>/dev/null || echo "none")

    case "${action}" in
        apply)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            rules_json=$(echo "${response}" | jq -c '.service_response.rules')
            window_seconds=$(echo "${response}" | jq -r '.service_response.window_seconds')

            # Belt and braces on top of Core's own one-test-at-a-time gate:
            # a fresh read of the state file, because the armed timer may
            # have resolved (or not) since this cycle's poll was sent. If a
            # test is still armed without its resolved marker, applying a
            # second one would put two rulesets' worth of uncertainty on
            # the host with one shared revert path, so this refuses and
            # keeps polling until the held test resolves.
            held_test_id=$(cat "${CURRENT_TEST_FILE}" 2>/dev/null || echo "")
            if [ -n "${held_test_id}" ] && [ ! -e "$(resolved_marker_for "${held_test_id}")" ]; then
                bashio::log.warning "Firewall: refusing to apply test B while test A is still armed (held ${held_test_id}, offered ${test_id})."
            else
                bashio::log.info "Applying proposed firewall ruleset (test ${test_id}, ${window_seconds}s to confirm)."
                # Both backups, both checked (work item 2.3): the full
                # filter-table dump for manual recovery, and the chain-only
                # snapshot the revert replays. A test whose revert path
                # cannot be guaranteed must never be applied, so a failure
                # of either write refuses the whole test: nothing touched
                # the chain yet, the net effect is the pre-test state, and
                # the honest report status is therefore "reverted" (the
                # protocol carries a status only; the backup_failed reason
                # lives in this log line).
                backups_ok=1
                iptables-save -t filter > "$(backup_path_for "${test_id}")" || backups_ok=0
                iptables -S "${CHAIN}" > "$(chain_backup_path_for "${test_id}")" || backups_ok=0
                if [ "${backups_ok}" -ne 1 ]; then
                    bashio::log.error "Firewall test ${test_id}: pre-test backup failed (backup_failed); refusing to apply. The live ruleset is untouched."
                    touch "$(resolved_marker_for "${test_id}")"
                    report_resolution "${test_id}" "reverted"
                else
                    echo -n "${test_id}" > "${CURRENT_TEST_FILE}"
                    if apply_ruleset "${rules_json}"; then
                        arm_revert_timer "${test_id}" "${window_seconds}"
                    else
                        # A rule failed to apply; don't leave a half-applied
                        # ruleset live. This rollback is a revert, so it is
                        # chain-scoped like every other revert: replay the
                        # chain snapshot, never iptables-restore the table.
                        bashio::log.error "Firewall test ${test_id} failed to apply cleanly; replaying the pre-test chain snapshot."
                        replay_chain_backup "$(chain_backup_path_for "${test_id}")" || true
                        touch "$(resolved_marker_for "${test_id}")"
                        report_resolution "${test_id}" "reverted"
                        : > "${CURRENT_TEST_FILE}"
                    fi
                fi
            fi
            ;;
        confirm)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            confirm_test "${test_id}"
            : > "${CURRENT_TEST_FILE}"
            ;;
        revert)
            test_id=$(echo "${response}" | jq -r '.service_response.test_id')
            revert_test "${test_id}"
            : > "${CURRENT_TEST_FILE}"
            ;;
        *)
            :
            ;;
    esac

    # Resource hard caps: apply immediately when the delivered set changes,
    # and re-apply every ~60s regardless — Supervisor recreates containers
    # on add-on update/restart, silently dropping any Docker-level limit,
    # so idempotent re-application is the only way a cap actually persists.
    new_limits=$(echo "${response}" | jq -c '.service_response.resource_limits.limits // empty' 2>/dev/null || echo "")
    if [ -n "${new_limits}" ]; then
        old_limits=$(cat "${LIMITS_FILE}" 2>/dev/null || echo "{}")
        if [ "${new_limits}" != "${old_limits}" ]; then
            echo "${new_limits}" > "${LIMITS_FILE}"
            bashio::log.info "Resource cap set changed — applying now."
            apply_resource_limits
        fi
    elif [ -s "${LIMITS_FILE}" ] && [ "$(cat "${LIMITS_FILE}")" != "{}" ]; then
        # Core no longer sends any caps — clear ours (resets containers).
        echo "{}" > "${LIMITS_FILE}"
        bashio::log.info "All resource caps cleared by HA SOC — resetting containers."
        apply_resource_limits
    fi
    poll_counter=$(( poll_counter + 1 ))
    if [ $(( poll_counter % LIMIT_APPLY_EVERY )) -eq 0 ] \
        && [ -s "${LIMITS_FILE}" ] && [ "$(cat "${LIMITS_FILE}")" != "{}" ]; then
        apply_resource_limits
    fi

    sleep "${POLL_INTERVAL_SECONDS}"
done

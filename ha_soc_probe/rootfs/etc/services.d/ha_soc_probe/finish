#!/usr/bin/with-contenv bashio
# The run script's loop only ever exits on its own for a trapped
# TERM/INT (a deliberate stop, exit 0; the carried graceful-stop item),
# so a zero exit code here is a routine stop and is logged as such. Any
# other code is a genuine crash; s6 restarts the service automatically
# after this script returns, and this line is what makes that visible in
# the add-on's log without making a routine update read as a crash loop.
EXIT_CODE="${1:-0}"
if [ "${EXIT_CODE}" -eq 0 ] 2>/dev/null; then
    bashio::log.info "HA SOC Probe stopped cleanly."
else
    bashio::log.warning "HA SOC Probe exited with code ${EXIT_CODE}; s6 will restart it."
fi

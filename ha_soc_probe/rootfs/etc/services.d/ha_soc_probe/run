#!/usr/bin/with-contenv bashio
# ==============================================================================
# HA SOC Probe — reports the host's real listening TCP ports to HA SOC.
#
# This only works because config.yaml sets host_network: true: this
# container shares the host's network namespace, so /proc/net/tcp[6] here
# IS the host's actual connection table, not a container-local one.
#
# Deliberately port + protocol only, never a process name: attributing a
# listening socket back to the process that owns it needs host_pid: true
# (walking every process's /proc/<pid>/fd on the host), a privilege this
# add-on does not request. That's a documented limitation, not a bug.
# ==============================================================================
set -euo pipefail

# Keep in lockstep with config.yaml's `version:` on every release.
SCANNER_VERSION="2026.08.23.3"

SCAN_INTERVAL_HOURS=$(bashio::config 'scan_interval_hours')
CORE_SERVICE_URL="http://supervisor/core/api/services/ha_soc/ingest_probe_result"

# When a report is rejected (e.g. HTTP 400 — the HA SOC integration isn't
# loaded yet, commonly for a few seconds/minutes right after Home Assistant
# Core itself restarts), don't wait out the full scan interval before trying
# again: that can be up to 24h, during which this add-on looks "running but
# stuck" with nothing to show it's actually just waiting. Hold in a short,
# capped-exponential retry loop instead, so it reconnects within seconds to
# a few minutes of the integration coming back — and says so, clearly and
# repeatedly, in this add-on's own log every time it retries.
RETRY_INTERVAL_SECONDS=30
MAX_RETRY_INTERVAL_SECONDS=300

# Prints "<proto> <hex-bind-address> <hex-port>" for every LISTEN-state
# row in a /proc/net/{tcp,tcp6} table. Column 2 is
# "hex_bind_address:hex_port", column 4 is connection state; 0A is
# TCP_LISTEN. Plain field/string handling only, no gawk-only extensions
# (strtonum etc.) — Alpine's default awk is busybox awk, not gawk.
extract_listening_ports() {
    local file="$1" proto="$2"
    [ -r "${file}" ] || return 0
    awk -v proto="${proto}" '
        NR > 1 && $4 == "0A" {
            split($2, addr, ":")
            print proto " " addr[1] " " addr[2]
        }
    ' "${file}"
}

# /proc/net/tcp's bind address is 8 hex chars — the 4 bytes of an IPv4
# address in the kernel's native (little-endian) word order, i.e.
# reversed relative to normal dotted-decimal reading order. "0100007F"
# is 127.0.0.1: bytes 01 00 00 7F read backwards. Same printf-based
# hex->decimal conversion already used for the port, applied per octet.
hex_to_ipv4() {
    local hex="$1"
    printf '%d.%d.%d.%d' \
        "0x${hex:6:2}" "0x${hex:4:2}" "0x${hex:2:2}" "0x${hex:0:2}"
}

# "<ip> <interface>" for every IPv4 address currently configured on the
# host — real, not guessed, since this add-on shares the host's network
# namespace (host_network: true in config.yaml). Degrades to nothing if
# `ip` isn't available, which just means every port reports its bind
# address with an "unresolved" interface below rather than failing outright.
build_interface_map() {
    command -v ip >/dev/null 2>&1 || return 0
    ip -4 -o addr show 2>/dev/null | awk '{split($4, cidr, "/"); print cidr[1], $2}'
}

# Builds a JSON array of {"port", "proto", "address", "interface"}
# objects from the host's current listening sockets. IPv6 addresses
# (32 hex chars, four little-endian 32-bit words — a materially more
# involved decode than IPv4's single 32-bit swap) are deliberately left
# unresolved rather than risk silently reporting a wrong address: a
# security tool showing an incorrect bind address is worse than one that
# honestly says "not decoded".
build_open_ports_json() {
    local entries
    entries=$(
        { extract_listening_ports /proc/net/tcp tcp
          extract_listening_ports /proc/net/tcp6 tcp
        } | sort -u
    )

    if [ -z "${entries}" ]; then
        echo "[]"
        return
    fi

    declare -A iface_map
    local iface_line ip ifname
    while read -r iface_line; do
        [ -n "${iface_line}" ] || continue
        ip=${iface_line%% *}
        ifname=${iface_line#* }
        iface_map["${ip}"]="${ifname}"
    done <<IFACES
$(build_interface_map)
IFACES

    local json="[" first=1 proto ip_hex port_hex port_dec address interface
    while read -r proto ip_hex port_hex; do
        port_dec=$(printf '%d' "0x${port_hex}")
        if [ "${#ip_hex}" -eq 8 ]; then
            address=$(hex_to_ipv4 "${ip_hex}")
            if [ "${address}" = "0.0.0.0" ]; then
                interface="(all interfaces)"
            else
                interface="${iface_map[${address}]:-unresolved}"
            fi
        else
            address="null"
            interface="null"
        fi
        if [ "${first}" -eq 1 ]; then
            first=0
        else
            json="${json},"
        fi
        json="${json}{\"port\":${port_dec},\"proto\":\"${proto}\","
        if [ "${address}" = "null" ]; then
            json="${json}\"address\":null,\"interface\":null}"
        else
            json="${json}\"address\":\"${address}\",\"interface\":\"${interface}\"}"
        fi
    done <<PORTS
${entries}
PORTS
    json="${json}]"
    echo "${json}"
}

bashio::log.info "HA SOC Probe starting — scanning every ${SCAN_INTERVAL_HOURS}h."

retry_seconds="${RETRY_INTERVAL_SECONDS}"

while true; do
    open_ports_json=$(build_open_ports_json)
    port_count=$(echo "${open_ports_json}" | jq 'length')
    bashio::log.info "Found ${port_count} listening TCP port(s) on the host."

    payload=$(jq -n \
        --argjson open_ports "${open_ports_json}" \
        --arg version "${SCANNER_VERSION}" \
        '{open_ports: $open_ports, scanner_version: $version}')

    http_code=$(curl -sS -o /tmp/ha_soc_probe_response.json -w '%{http_code}' \
        -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${CORE_SERVICE_URL}" || echo "000")

    if [ "${http_code}" = "200" ]; then
        bashio::log.info "Reported to HA SOC."
        retry_seconds="${RETRY_INTERVAL_SECONDS}"
        sleep "$(( SCAN_INTERVAL_HOURS * 3600 ))"
        continue
    fi

    # Holding, not crashing: a 400 here almost always means the HA SOC
    # integration's service isn't registered yet (not loaded, or Core is
    # mid-restart) rather than anything wrong with this add-on itself.
    # Retry soon instead of waiting out the full scan interval, and say so
    # plainly and repeatedly — this line is the "half setup" flag the user
    # sees in the add-on's own log until the integration side catches up.
    bashio::log.warning "Holding — HA SOC did not accept the report (HTTP ${http_code}). Is the HA SOC integration installed and loaded? Retrying in ${retry_seconds}s."
    sleep "${retry_seconds}"
    retry_seconds=$(( retry_seconds * 2 ))
    if [ "${retry_seconds}" -gt "${MAX_RETRY_INTERVAL_SECONDS}" ]; then
        retry_seconds="${MAX_RETRY_INTERVAL_SECONDS}"
    fi
done

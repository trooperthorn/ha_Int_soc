#!/usr/bin/with-contenv bashio
# HA SOC Probe: reports the host's real listening TCP ports (host_network: true makes /proc/net/tcp[6] the host table).
# Port and protocol only; process attribution would need host_pid, which this add-on does not request.
set -euo pipefail

# Keep in lockstep with config.yaml's `version:` on every release.
SCANNER_VERSION="2026.09.06.1"

CORE_SERVICE_URL="http://supervisor/core/api/services/ha_soc/ingest_probe_result"

# Per-install secret shared with the sibling services via /data; Core pins the first value it sees.
SECRET_FILE="/data/ha_soc_probe_secret"
PROBE_SECRET=""

ensure_probe_secret() {
    mkdir -p /data
    if [ ! -s "${SECRET_FILE}" ]; then
        ( set -o noclobber
          umask 077
          head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1 > "${SECRET_FILE}"
        ) 2>/dev/null || true
    fi
    # Tighten a pre-existing file to 0600 too.
    chmod 600 "${SECRET_FILE}" 2>/dev/null || true
    PROBE_SECRET="$(cat "${SECRET_FILE}" 2>/dev/null || echo "")"
}

# Root does only secret creation and bashio::config here, then re-execs as nobody via `bashio "$0"`; see docs/security.md.
if [ "$(id -u)" -eq 0 ]; then
    ensure_probe_secret
    HA_SOC_SCAN_INTERVAL_HOURS="$(bashio::config 'scan_interval_hours')"
    export HA_SOC_SCAN_INTERVAL_HOURS
    export HA_SOC_PROBE_SECRET="${PROBE_SECRET}"
    # A response file left by an earlier root run would be unwritable for nobody.
    rm -f /tmp/ha_soc_probe_response.json 2>/dev/null || true
    if command -v s6-setuidgid >/dev/null 2>&1; then
        exec s6-setuidgid nobody bashio "$0"
    fi
    bashio::log.warning "s6-setuidgid not found; the port scanner is running as root this session instead of dropping to nobody."
fi

SCAN_INTERVAL_HOURS="${HA_SOC_SCAN_INTERVAL_HOURS:-6}"
PROBE_SECRET="${HA_SOC_PROBE_SECRET:-}"

# TERM/INT trap: sleeps are backgrounded so a stop lands immediately and the loop exits 0.
STOP_REQUESTED=0
on_stop_signal() {
    STOP_REQUESTED=1
}
trap on_stop_signal TERM INT

interruptible_sleep() {
    sleep "$1" &
    wait $! 2>/dev/null || true
}

exit_if_stop_requested() {
    if [ "${STOP_REQUESTED}" -eq 1 ]; then
        bashio::log.info "HA SOC Probe received a stop signal; exiting cleanly."
        exit 0
    fi
}

# A rejected report retries on a capped-exponential schedule instead of waiting out the scan interval.
RETRY_INTERVAL_SECONDS=30
MAX_RETRY_INTERVAL_SECONDS=300

# Column 4 == 0A is TCP_LISTEN; busybox awk only, no gawk extensions.
extract_listening_ports() {
    local file="$1" proto="$2"
    [ -r "${file}" ] || return 0
    awk -v proto="${proto}" '
        NR > 1 && $4 == "0A" {
            split($2, addr, ":")
            print proto " " addr[1] " " addr[2]
        }
    ' "${file}"
}

# The 8 hex chars are the IPv4 address in little-endian byte order (0100007F is 127.0.0.1).
hex_to_ipv4() {
    local hex="$1"
    printf '%d.%d.%d.%d' \
        "0x${hex:6:2}" "0x${hex:4:2}" "0x${hex:2:2}" "0x${hex:0:2}"
}

# Real host addresses (host_network); a missing `ip` yields "unresolved" interfaces instead of failing.
build_interface_map() {
    command -v ip >/dev/null 2>&1 || return 0
    ip -4 -o addr show 2>/dev/null | awk '{split($4, cidr, "/"); print cidr[1], $2}'
}

# IPv6 addresses are left unresolved (null) rather than risk a wrong decode.
build_open_ports_json() {
    local entries
    entries=$(
        { extract_listening_ports /proc/net/tcp tcp
          extract_listening_ports /proc/net/tcp6 tcp
        } | sort -u
    )

    if [ -z "${entries}" ]; then
        echo "[]"
        return
    fi

    declare -A iface_map
    local iface_line ip ifname
    while read -r iface_line; do
        [ -n "${iface_line}" ] || continue
        ip=${iface_line%% *}
        ifname=${iface_line#* }
        iface_map["${ip}"]="${ifname}"
    done <<IFACES
$(build_interface_map)
IFACES

    local json="[" first=1 proto ip_hex port_hex port_dec address interface
    while read -r proto ip_hex port_hex; do
        port_dec=$(printf '%d' "0x${port_hex}")
        if [ "${#ip_hex}" -eq 8 ]; then
            address=$(hex_to_ipv4 "${ip_hex}")
            if [ "${address}" = "0.0.0.0" ]; then
                interface="(all interfaces)"
            else
                interface="${iface_map[${address}]:-unresolved}"
            fi
        else
            address="null"
            interface="null"
        fi
        if [ "${first}" -eq 1 ]; then
            first=0
        else
            json="${json},"
        fi
        json="${json}{\"port\":${port_dec},\"proto\":\"${proto}\","
        if [ "${address}" = "null" ]; then
            json="${json}\"address\":null,\"interface\":null}"
        else
            json="${json}\"address\":\"${address}\",\"interface\":\"${interface}\"}"
        fi
    done <<PORTS
${entries}
PORTS
    json="${json}]"
    echo "${json}"
}

bashio::log.info "HA SOC Probe starting, scanning every ${SCAN_INTERVAL_HOURS}h as $(id -un)."

retry_seconds="${RETRY_INTERVAL_SECONDS}"

while true; do
    exit_if_stop_requested
    open_ports_json=$(build_open_ports_json)
    port_count=$(echo "${open_ports_json}" | jq 'length')
    bashio::log.info "Found ${port_count} listening TCP port(s) on the host."

    payload=$(jq -n \
        --argjson open_ports "${open_ports_json}" \
        --arg version "${SCANNER_VERSION}" \
        --arg probe_secret "${PROBE_SECRET}" \
        '{open_ports: $open_ports, scanner_version: $version, probe_secret: $probe_secret}')

    http_code=$(curl -sS -o /tmp/ha_soc_probe_response.json -w '%{http_code}' \
        -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${CORE_SERVICE_URL}" || echo "000")

    if [ "${http_code}" = "200" ]; then
        bashio::log.info "Reported to HA SOC."
        retry_seconds="${RETRY_INTERVAL_SECONDS}"
        interruptible_sleep "$(( SCAN_INTERVAL_HOURS * 3600 ))"
        continue
    fi

    # Holding, not crashing: a 400 usually means the HA SOC service is not registered yet.
    exit_if_stop_requested
    bashio::log.warning "Holding — HA SOC did not accept the report (HTTP ${http_code}). Is the HA SOC integration installed and loaded? Retrying in ${retry_seconds}s."
    interruptible_sleep "${retry_seconds}"
    retry_seconds=$(( retry_seconds * 2 ))
    if [ "${retry_seconds}" -gt "${MAX_RETRY_INTERVAL_SECONDS}" ]; then
        retry_seconds="${MAX_RETRY_INTERVAL_SECONDS}"
    fi
done

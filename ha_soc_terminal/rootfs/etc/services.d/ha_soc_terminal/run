#!/usr/bin/with-contenv bashio
# HA SOC Terminal: one ttyd, one PTY per connection, every connection through the session wrapper.
# No tmux, so nothing is shared between connections; see docs/TERMINAL-DESIGN.md.
set -euo pipefail

# Keep in lockstep with config.yaml's `version:` on every release.
TERMINAL_VERSION="2026.09.12.1"

SESSIONS_DIR="/data/sessions"
HISTORY_FILE="/data/.bash_history"
SECRET_FILE="/data/ha_soc_terminal_secret"
PAIR_URL="http://supervisor/core/api/services/ha_soc/pair_terminal"

mkdir -p "${SESSIONS_DIR}"
chmod 700 "${SESSIONS_DIR}"

# The ttyd credential: generated once per install, mode 0600, handed to Core
# through ha_soc.pair_terminal, which pins the first value it sees. Never
# exported into a session; the wrapper and the shell do not know it.
if [ ! -s "${SECRET_FILE}" ]; then
    ( umask 077; head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1 > "${SECRET_FILE}" )
fi
chmod 600 "${SECRET_FILE}"
TERMINAL_SECRET="$(cat "${SECRET_FILE}")"

pair_with_core() {
    # Retried in the background until Core accepts; a 400 usually means the
    # HA SOC integration is not loaded yet. Accepted with a mismatch means a
    # different secret is pinned; the log says so and the app keeps running,
    # since the panel explains the un-paired state and how to reset it.
    local delay=5 code body
    local token="${SUPERVISOR_TOKEN}"
    while true; do
        body="$(jq -n --arg secret "${TERMINAL_SECRET}" --arg version "${TERMINAL_VERSION}" \
            '{secret: $secret, version: $version}')"
        code="$(curl -sS -o /tmp/pair_response.json -w '%{http_code}' -X POST \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${PAIR_URL}?return_response" 2>/dev/null || echo 000)"
        if [ "${code}" = "200" ]; then
            if grep -q '"accepted": *true' /tmp/pair_response.json 2>/dev/null; then
                bashio::log.info "Paired with HA SOC."
            else
                bashio::log.warning "HA SOC refused the pairing: $(cat /tmp/pair_response.json 2>/dev/null). Delete /data/ha_soc_terminal_secret on this app and forget the pairing in HA SOC Settings to re-pair."
            fi
            rm -f /tmp/pair_response.json
            return 0
        fi
        bashio::log.info "HA SOC did not accept the pairing yet (HTTP ${code}); retrying in ${delay}s."
        sleep "${delay}"
        delay=$(( delay * 2 ))
        [ "${delay}" -gt 300 ] && delay=300
    done
}
pair_with_core &

# Options reach the wrapper and the shell as environment only; SUPERVISOR_TOKEN
# is deliberately not exported into the session environment.
HA_SOC_TERM_RECORD="$(bashio::config 'session_recording')"
HA_SOC_TERM_HISTORY="$(bashio::config 'history_persist')"
HA_SOC_TERM_IDLE_MINUTES="$(bashio::config 'idle_timeout_minutes')"
export HA_SOC_TERM_RECORD HA_SOC_TERM_HISTORY HA_SOC_TERM_IDLE_MINUTES
export HA_SOC_TERM_VERSION="${TERMINAL_VERSION}"
export HA_SOC_TERM_SESSIONS_DIR="${SESSIONS_DIR}"
export HA_SOC_TERM_HISTORY_FILE="${HISTORY_FILE}"

if bashio::var.true "${HA_SOC_TERM_HISTORY}"; then
    touch "${HISTORY_FILE}"
    chmod 600 "${HISTORY_FILE}"
fi

# The Supervisor maps the configuration directory at /homeassistant. The
# AppArmor profile keeps / read-only, so the convenience link lives in the
# shell's home instead of at the root.
[ -e /root/config ] || ln -s /homeassistant /root/config

bashio::log.info "HA SOC Terminal ${TERMINAL_VERSION}: recording=${HA_SOC_TERM_RECORD}, history=${HA_SOC_TERM_HISTORY}, idle=${HA_SOC_TERM_IDLE_MINUTES}m"

cd /root

# ttyd and every shell under it inherit this process's environment, so the
# Supervisor token is removed here, after the pairing loop captured what it
# needs. The ha wrapper re-imports it for the CLI process alone.
unset SUPERVISOR_TOKEN

# Basic auth with the pinned credential: only HA SOC's proxy holds it, so
# nothing else on the Supervisor network can open a shell here. The panel's
# own xterm.js carries the theme; ttyd's built-in page is never served to a
# browser.
exec ttyd \
    --port 7681 \
    --credential "hasoc:${TERMINAL_SECRET}" \
    --writable \
    /usr/local/bin/ha_soc_term_open
